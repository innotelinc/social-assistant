# ============================================================
# SocialAI — Environment Variables
# Copy to .env and fill in. All values optional unless marked.
#   cp .env.example .env
# ============================================================

# The public URL this instance is served from (used for OAuth
# redirect URIs + Stripe redirects). Required in production.
PUBLIC_URL=https://socialai.innotel.us

# Port for `next start` (Docker default: 3000)
PORT=3000

# --- Optional: real AI generation (OpenAI / Anthropic) --------
# Leave blank to use the built-in AI engine (works out of the box).
# Users can also paste their own key in Settings → AI.
# AI_PROVIDER=openai            # openai | anthropic
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Optional: Stripe subscriptions ---------------------------
# Create three recurring Prices (Creator $49/mo, Business $149/mo,
# Agency $499/mo) and paste their IDs below. Leave blank to run
# without billing (everyone gets unlimited access).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CREATOR_PRICE_ID=price_...
# STRIPE_BUSINESS_PRICE_ID=price_...
# STRIPE_AGENCY_PRICE_ID=price_...

# --- Optional: social platform API keys -----------------------
# Set at the app level (shared by all users) OR per-user in
# Settings → Platform API Keys. Each platform requires a developer
# app. OAuth callback: {PUBLIC_URL}/api/oauth/{platform}/callback
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
